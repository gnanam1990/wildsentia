DATABASE_URL=postgres://vana:vana@localhost:5433/vana
PORT=8080
# People's accounts (sign in with X; needs VANA_LIVE_AGENTS=1). All three, or none:
# VANA_X_CLIENT_ID=your-x-oauth2-client-id
# VANA_X_CLIENT_SECRET=your-x-oauth2-client-secret
# VANA_X_REDIRECT_URI=https://your-forest.example/api/accounts/x/callback
WORLD_SEED=1
# Leave unset for a fresh world or an unchanged-version restart. A backed-up
# sim_0.28.0 checkpoint needs explicit operator approval before enabling this once.
# VANA_ALLOW_V28_UPGRADE=1
