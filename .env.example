DATABASE_URL=postgres://vana:vana@localhost:5433/vana
PORT=8080
# People's accounts (sign in with X; needs VANA_LIVE_AGENTS=1). All three, or none:
# VANA_X_CLIENT_ID=your-x-oauth2-client-id
# VANA_X_CLIENT_SECRET=your-x-oauth2-client-secret
# VANA_X_REDIRECT_URI=https://your-forest.example/api/accounts/x/callback
WORLD_SEED=1
# Forest experiences: local opponents and text guide work without provider credentials.
# VANA_EXPERIENCES_ORIGIN=http://localhost:5173
# OPENROUTER_API_KEY=configure-in-your-secret-manager
# VANA_LEAGUE_MODELS=provider/pinned-model-id,other-provider/pinned-model-id
# VANA_LEAGUE_PUBLIC_MODELS=1
# VANA_LEAGUE_DAILY_TOKENS=200000
# VANA_SAFARI_LIVEKIT=1
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=configure-in-your-secret-manager
# LIVEKIT_API_SECRET=configure-in-your-secret-manager
# VANA_VOICE_DAILY_SECONDS=1800
# VANA_SAFARI_API_URL=http://127.0.0.1:8080/experiences/safari
# VANA_SAFARI_LLM=provider/pinned-model-id
# Leave unset for a fresh world or an unchanged-version restart. A backed-up
# sim_0.28.0 checkpoint needs explicit operator approval before enabling this once.
# VANA_ALLOW_V28_UPGRADE=1
