{
  "name": "vana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "verify:ci": "tsx tools/ci/verify.ts",
    "soak": "tsx packages/runner/src/soak.ts",
    "dev:server": "tsx packages/server/src/index.ts",
    "dev:client": "npm --workspace @vana/client run dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
